/FP_ZERO=1+0
/FP_ZEROS=1+0+1+0+1+0+1+0
/FP_CORNER1=-8.001+-608.00098+0.+-8.001+-0.001+0.+0.+-8.+0.+0.+600.+0.
/FP_CORNER2=-408.00098+-607.99994+0.+-408.00098+0.001+0.+400.+-8.+0.+400.+600.+0.
/FP_CORNER3=-407.99899+-7.999+0.+-407.99899+600.001+0.+400.+-607.99994+0.+400.+0.+0.
/FP_CORNER4=-7.999+-8.001+0.+-7.999+599.999+0.+0.+-607.99994+0.+0.+0.+0.
