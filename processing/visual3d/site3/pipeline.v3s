File_New

;

Set_Pipeline_Parameter_To_Folder_Path
/PARAMETER_NAME=DATA_FOLDER
/PARAMETER_VALUE=
! /FROM_MOTION_FILE_IN_WORKSPACE=
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_APPEND=
/SET_PROMPT=Select a c3d data directory
! /ALPHABETIZE=TRUE
;

Set_Pipeline_Parameter
/PARAMETER_NAME=V3D_MODEL
/PARAMETER_VALUE=model.mdh

!/PARAMETER_VALUE=::MODEL_FOLDER&fullbody-general-1114.mdh
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

Set_Pipeline_Parameter
/PARAMETER_NAME= All_Activity_Names
/PARAMETER_VALUE= baseline
! /+walk_speed_large+fpa_large+fpa_small+step_width_large+step_width_small+trunk_sway_large+trunk_sway_small+dual_task+sit2stand
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

For_Each
/ITERATION_PARAMETER_NAME= Activity_Name
! /ITERATION_PARAMETER_COUNT_NAME
/ITEMS= ::All_Activity_Names
;

Set_Pipeline_Parameter
/PARAMETER_NAME= Activity_Calib_File
/PARAMETER_VALUE= ::DATA_FOLDER&Calib_&::Activity_Name&*.c3d
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

Set_Pipeline_Parameter
/PARAMETER_NAME= Activity_File
/PARAMETER_VALUE= ::DATA_FOLDER&::Activity_Name&*.c3d
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
! /MULTI_PASS=FALSE
;

Create_Hybrid_Model
/CALIBRATION_FILE=::Activity_Calib_File
! /SUFFIX=
!/RANGE=100+150
! /SET_PROMPT=
;

Apply_Model_Template
! /CALIBRATION_FILE=
/MODEL_TEMPLATE=::V3D_MODEL
! /SET_PROMPT=Open model file
! /VIEW_BUILDMODEL_RESULTS=2
;

Set_Subject_Mass
! /CALIBRATION_FILE=
! /PROMPT=
! /PROMPT_SIZE=90
/WEIGHT=REPLACE_WITH_MEASURED_VALUE
/UNITS=kg
