/ITERATION_PARAMETER_NAME=FILE
;

Recalc

;

For_Each
/ITERATION_PARAMETER_NAME=FILE
/ITEMS=::FILES
;

! Create a pipeline parameter containing the name of the c3d file
! but replace the extension .c3d with the extension .txt which
! will be used for the exported file.

Set_Pipeline_Parameter
/PARAMETER_NAME=CSV_FILE
/PARAMETER_VALUE=::FILE
/PARAMETER_VALUE_SEARCH_FOR=.c3d
/PARAMETER_VALUE_REPLACE_WITH=.csv
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
;

Set_Pipeline_Parameter
/PARAMETER_NAME=CSV_FILE
/PARAMETER_VALUE=::CSV_FILE
/PARAMETER_VALUE_SEARCH_FOR=vicon
/PARAMETER_VALUE_REPLACE_WITH=v3d
! /PARAMETER_VALUE_PREFIX=
! /PARAMETER_VALUE_APPEND=
;

! Select active file
Select_Active_File
/FILE_NAME=::FILE
! /QUERY=
;

! Loop to convert events from time to frames for 4 HS reps
For_Each
/ITERATION_PARAMETER_NAME=INDEX
/ITEMS=LOFF+LON+ROFF+RON
;

! Expression to convert events wrt frames
Evaluate_Expression
/EXPRESSION=EVENT_LABEL::ORIGINAL&:&:&::INDEX&*PARAMETERS::POINT::RATE+1
/RESULT_NAME=::INDEX
/RESULT_TYPE=METRIC
/RESULT_FOLDER=EVENT_EXPORT
;

End_For_Each
/ITERATION_PARAMETER_NAME=INDEX
;

Export_Data_To_Ascii_File
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=RIGHT_HIP_ANGLE+RIGHT_HIP_ANGLE+RIGHT_HIP_ANGLE+RIGHT_HIP_MOMENT+RIGHT_HIP_MOMENT+RIGHT_HIP_MOMENT+RIGHT_KNEE_ANGLE+RIGHT_KNEE_ANGLE+RIGHT_KNEE_ANGLE+RIGHT_KNEE_MOMENT+RIGHT_KNEE_MOMENT+RIGHT_KNEE_MOMENT+RIGHT_ANKLE_ANGLE+RIGHT_ANKLE_ANGLE+RIGHT_ANKLE_ANGLE+RIGHT_ANKLE_MOMENT+RIGHT_ANKLE_MOMENT+RIGHT_ANKLE_MOMENT+LEFT_HIP_ANGLE+LEFT_HIP_ANGLE+LEFT_HIP_ANGLE+LEFT_HIP_MOMENT+LEFT_HIP_MOMENT+LEFT_HIP_MOMENT+LEFT_KNEE_ANGLE+LEFT_KNEE_ANGLE+LEFT_KNEE_ANGLE+LEFT_KNEE_MOMENT+LEFT_KNEE_MOMENT+LEFT_KNEE_MOMENT+LEFT_ANKLE_ANGLE+LEFT_ANKLE_ANGLE+LEFT_ANKLE_ANGLE+LEFT_ANKLE_MOMENT+LEFT_ANKLE_MOMENT+LEFT_ANKLE_MOMENT
/FILE_NAME=::CSV_FILE
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z, X, Y, Z
/SIGNAL_PRECISION=5
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /USE_P2D_FORMAT=FALSE
! /USE_XML_FORMAT=FALSE
! /USE_SHORT_FILENAME=FALSE
! /EXPORT_EMPTY_SIGNALS=FALSE
! /EXPORT_WITHOUT_HEADER=FALSE
! /EXPORT_NAN=FALSE
! /USE_SCIENTIFIC_NOTATION=FALSE
;

End_For_Each
/ITERATION_PARAMETER_NAME=FILE
;

Set_Pipeline_Parameter_To_List_Of_Tagged_Files
/PARAMETER_NAME=FILES
/TAG_NAME=ALL_FILES
! /GET_CURRENT_SELECTED_FILES=false
