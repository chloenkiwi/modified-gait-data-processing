! /DISPLAY_RESULTS=TRUE
;

File_Open
 /FILE_NAME=::Activity_File
! /SUFFIX=
! /SET_PROMPT=File_Open
! /FILTER=
;

Assign_Model_File
/CALIBRATION_FILE=::Activity_Calib_File
/MOTION_FILE_NAMES=::Activity_File
;

Assign_Tags_To_Files
/MOTION_FILE_NAMES= ::Activity_File
! /QUERY=
/TAGS=::Activity_Name
;

End_For_Each
/ITERATION_PARAMETER_NAME=Activity_Name
